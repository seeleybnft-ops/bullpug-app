    "icons": {
      "library": "lucide-react",
      "preferred_icons": ["Rocket", "Moon", "Zap", "Wallet", "Coins", "Gamepad2", "ShoppingCart", "BarChart3"]
    }
  },
  "implementation_plan": {
    "phases": [
      {
        "name": "Phase 1: Setup & Theme",
        "tasks": [
          "Install fonts: Orbitron and Space Grotesk",
          "Configure tailwind.config.js with neon colors and font families",
          "Set global body background to dark cosmic theme",
          "Create 'StarField' background component using canvas or tsparticles"
        ]
      },
      {
        "name": "Phase 2: Core Components",
        "tasks": [
          "Create 'NeonButton' component",
          "Create 'GlassCard' component",
          "Create 'Navbar' with floating glass effect and wallet connect button",
          "Create 'Footer' with big social links"
        ]
      },
      {
        "name": "Phase 3: Hero & Marketing",
        "tasks": [
          "Build Hero section with floating 3D coin animation (Framer Motion)",
          "Implement 'Lore' section with parallax scrolling",
          "Build 'Roadmap' using a vertical timeline with rocket icon markers"
        ]
      },
      {
        "name": "Phase 4: Features (The Fun Stuff)",
        "tasks": [
          "Tokenomics: Use Recharts for a 'Supply' donut chart with neon strokes",
          "Betting Arena: Create a 3D CSS Coin Flip animation component",
          "Exit Simulator: Build a calculator with sliders and P&L chart",
          "Shop: Grid layout for Plushies with 'Add to Cart' hover effect"
        ]
      }
    ]
  },
  "universal_guidelines": [
    "Use 'sonner' for all notifications (toasts).",
    "Avoid generic 'Inter' font. Use 'Orbitron' for headings.",
    "Do NOT use gradients for text if readability is compromised.",
    "Ensure all interactive elements have a hover state (glow or lift).",
    "Mobile Responsiveness is key - stack grids to 1 column on mobile.",
    "Use 'lucide-react' for icons.",
    "Add 'data-testid' to all interactive elements."
  ]
}