{
  "design_system": {
    "identity": {
      "name": "Bullpug",
      "tagline": "The Cosmic Guardian of the Memecoin Universe",
      "vibe": "Space, Fun, Neon, Community, Degens",
      "theme_mode": "dark"
    },
    "typography": {
      "font_family": {
        "heading": "Orbitron, sans-serif",
        "body": "Space Grotesk, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "scale": {
        "h1": "text-6xl md:text-8xl font-black tracking-tighter uppercase",
        "h2": "text-4xl md:text-5xl font-bold tracking-tight",
        "h3": "text-2xl md:text-3xl font-bold",
        "body": "text-base md:text-lg leading-relaxed text-slate-300",
        "caption": "text-xs uppercase tracking-widest text-slate-500"
      },
      "imports": [
        "https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Grotesk:wght@300;400;600&display=swap"
      ]
    },
    "colors": {
      "background": {
        "default": "#05050A",
        "paper": "#0F0F16",
        "card": "#13131F"
      },
      "primary": {
        "DEFAULT": "#00FFA3",
        "foreground": "#000000",
        "glow": "0 0 20px rgba(0, 255, 163, 0.5)"
      },
      "secondary": {
        "DEFAULT": "#D946EF",
        "foreground": "#FFFFFF",
        "glow": "0 0 20px rgba(217, 70, 239, 0.5)"
      },
      "accent": {
        "DEFAULT": "#F5D300",
        "foreground": "#000000",
        "glow": "0 0 15px rgba(245, 211, 0, 0.5)"
      },
      "destructive": {
        "DEFAULT": "#FF3B30",
        "foreground": "#FFFFFF"
      },
      "neutral": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A"
      },
      "gradients": {
        "cosmic": "linear-gradient(135deg, #1A1A2E 0%, #16213E 50%, #0F3460 100%)",
        "neon": "linear-gradient(90deg, #00FFA3 0%, #00C2FF 100%)",
        "sunset": "linear-gradient(90deg, #FF00FF 0%, #FF9900 100%)"
      }
    },
    "visual_enhancers": {
      "glassmorphism": "bg-black/30 backdrop-blur-xl border border-white/10 shadow-xl",
      "neon_border": "border border-primary/50 shadow-[0_0_10px_rgba(0,255,163,0.3)]",
      "card_hover": "hover:border-primary/50 hover:shadow-[0_0_15px_rgba(0,255,163,0.2)] hover:-translate-y-1 transition-all duration-300",
      "text_glow": "drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]"
    },
    "layout_strategies": {
      "container": "max-w-7xl mx-auto px-6 md:px-12",
      "section_spacing": "py-24 md:py-32",
      "grid_bento": "grid grid-cols-1 md:grid-cols-12 gap-6",
      "grid_cards": "grid grid-cols-1 md:grid-cols-3 gap-8"
    }
  },
  "components_map": {
    "buttons": {
      "primary": "bg-primary text-black font-bold uppercase tracking-wider hover:scale-105 transition-transform shadow-[0_0_20px_rgba(0,255,163,0.4)] rounded-full px-8 py-4",
      "secondary": "bg-transparent border-2 border-primary text-primary font-bold uppercase tracking-wider hover:bg-primary/10 transition-colors rounded-full px-8 py-4",
      "ghost": "text-slate-400 hover:text-white transition-colors font-medium uppercase tracking-wide"
    },
    "cards": {
      "default": "bg-card/50 backdrop-blur-sm border border-white/5 rounded-2xl p-6 overflow-hidden relative group",
      "highlight": "bg-gradient-to-br from-white/10 to-transparent border border-white/20 rounded-2xl p-8"
    },
    "inputs": {
      "default": "bg-black/50 border border-white/10 rounded-lg px-4 py-3 text-white placeholder-slate-500 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
    }
  },
